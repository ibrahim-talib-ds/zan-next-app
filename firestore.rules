rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.isAdmin == true;
    }
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // ═══════════════════════════════════════════════════════
    // INVENTORY — with viewers subcollection
    // ═══════════════════════════════════════════════════════
    match /Inventory/{itemId} {
      allow read: if isSignedIn();

      // Only the seller can create a new product
      allow create: if isSignedIn()
                    && request.resource.data.sellers_ref == currentUserPath();

      // Seller can edit own; admin can edit any
      allow update: if isSignedIn()
                    && (resource.data.sellers_ref == currentUserPath()
                        || isAdmin());

      // Seller can delete own; admin can delete any
      allow delete: if isSignedIn()
                    && (resource.data.sellers_ref == currentUserPath()
                        || isAdmin());

      // ─── UNIQUE VIEWERS subcollection ───
      match /viewers/{viewerId} {
        // Anyone signed in can register their own view
        allow create: if isSignedIn()
                      && viewerId == request.auth.uid
                      && request.resource.data.user_ref == currentUserPath();

        // Viewers are read-only after creation (nobody can change)
        allow read: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════
    // REPORTS — any user can create; only admins can read/update
    // ═══════════════════════════════════════════════════════
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporter_ref == currentUserPath()
                    && request.resource.data.status == 'pending';

      allow read: if isAdmin()
                  || (isSignedIn()
                      && resource.data.reporter_ref == currentUserPath());

      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // SUPPORT CHATS
    // ═══════════════════════════════════════════════════════
    match /support_chats/{chatId} {
      allow read, write: if isSignedIn()
                    && (isOwner(chatId) || isAdmin());

      match /messages/{msgId} {
        allow read, write: if isSignedIn()
                    && (isOwner(chatId) || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isSignedIn()
                    && (resource.data.user_ref == currentUserPath()
                        || isAdmin());
      allow write: if isAdmin() || isSignedIn();
    }

    // ═══════════════════════════════════════════════════════
    // SEARCH HISTORY — per user
    // ═══════════════════════════════════════════════════════
    match /search_history/{historyId} {
      allow read, write: if isSignedIn()
                    && (resource.data.user_ref == currentUserPath()
                        || request.resource.data.user_ref == currentUserPath()
                        || isAdmin());
    }

    // ═══════════════════════════════════════════════════════
    // EVERYTHING ELSE
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
