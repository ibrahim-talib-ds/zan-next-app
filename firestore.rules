rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(ref) {
      return isSignedIn() && request.auth.uid == ref.id;
    }

    // ─── ORDERS — buyer cannot order own product ───
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.buyer.id == request.auth.uid
        && request.resource.data.seller.id != request.auth.uid; // 🚫 no self-order
      allow update, delete: if isSignedIn()
        && (resource.data.buyer.id == request.auth.uid
            || resource.data.seller.id == request.auth.uid);
    }

    // ─── CHATS — no chat with yourself ───
    match /Chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.users.map(u, u.id);
      allow create: if isSignedIn()
        && request.resource.data.buyer_ref.id != request.resource.data.seller_ref.id; // 🚫 no self-chat
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users.map(u, u.id);
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.users.map(u, u.id);
    }

    // ─── CHAT MESSAGES ───
    match /chat_messages/{msgId} {
      allow read, create, delete: if isSignedIn();
    }

    // ─── NOTIFICATIONS — user can delete own ───
    match /notifications/{notifId} {
      allow read: if isSignedIn()
        && resource.data.user_ref.id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.user_ref.id == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ─── INVENTORY — public read, owner write ───
    match /inventory/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && resource.data.sellers_ref.id == request.auth.uid;
    }

    // ─── USERS — self write ───
    match /users/{userId} {
      allow read: if true;
      allow write: if isUserSelf(userId);
    }

    function isUserSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
  }
}
